{
  "expo": {
    "name": "Fitness Trail",
    "slug": "fitness-trail",
    "scheme": "fitness-trail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uniquedev.fitnesstrail",
      "infoPlist": {
        "CFBundleDisplayName": "Fitness Trail"
      }
    },
    "android": {
      "package": "com.uniquedev.fitnesstrail",
      "adaptiveIcon": {
        "backgroundColor": "#0B1830",
        "foregroundImage": "./src/assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fitness Trail to choose a profile picture from your photo library.",
          "cameraPermission": "Allow Fitness Trail to take a profile picture.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B1830",
          "dark": {
            "backgroundColor": "#08111F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
