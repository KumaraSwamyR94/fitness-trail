{
  "name": "fitness-trail",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.23.1",
    "yarn": "1.22.22"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "fflate": "^0.8.3",
    "papaparse": "^5.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "expo-doctor": "1.20.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "17.3.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.3",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --cache --cache-location .expo/cache/eslint --max-warnings=0",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --watchman=false",
    "test:watch": "jest --watch --watchman=false",
    "lint:commits": "commitlint --verbose",
    "doctor": "expo-doctor",
    "verify": "yarn format:check && yarn typecheck && yarn lint && yarn test && yarn doctor",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yaml,yml}": "prettier --write"
  },
  "volta": {
    "yarn": "1.22.22"
  }
}
